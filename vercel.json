{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "dist/**/* node_modules/.prisma/client/**/* prisma/schema.prisma server_prod.cjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}