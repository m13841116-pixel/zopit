generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     Int                     @id @default(autoincrement())
  username               String                  @unique
  password               String
  role                   String
  status                 String?                 @default("ACTIVE")
  firstName              String?
  lastName               String?
  mobile                 String?
  email                  String?
  nationalCode           String?
  brandName              String?
  activityType           String?
  address                String?
  province               String?
  city                   String?
  postalCode             String?
  telephone              String?
  website                String?
  accountHolderName      String?
  shaba                  String?
  bankName               String?
  cardNumber             String?
  agreementAccepted      Boolean?
  agreementVersion       String?
  agreementAcceptedAt    DateTime?
  storeName              String?
  storeUrl               String?
  storeLink              String?
  avatarUrl              String?
  platformType           String?
  fieldOfActivity        String?
  productCount           Int?
  performanceScore       Int                     @default(100)
  penaltyPoints          Int                     @default(0)
  warningLevel           String                  @default("NONE")
  referralCode           String?                 @unique
  logs                   ActivityLog[]
  adjustments            AdjustmentRecord[]
  auditTrails            AuditTrail[]
  customerOrders         CustomerOrder[]         @relation("StoreCustomerOrders")
  dailySelections        DailySelection[]
  notifications          Notification[]
  orders                 Order[]
  payments               Payment[]
  products               Product[]
  productCustomizations  ProductCustomization[]
  productQuestions       ProductQuestion[]
  referredSupplier       ReferrerReferral?       @relation("SupplierRel")
  referrerReferrals      ReferrerReferral[]      @relation("ReferrerRel")
  selectionCart          SelectionCart?
  settlements            Settlement[]
  storeConnection        StoreConnection?
  storeInvoices          StoreInvoice[]
  storeProductSelections StoreProductSelection[]
  storeSettings          StoreSettings?
  supplierPayables       SupplierPayable[]
  supplierPenalties      SupplierPenalty[]       @relation("SupplierPenalties")
  tickets                Ticket[]
  messages               TicketMessage[]
  wallet                 Wallet?
  proAccount             ProAccount?
}

model ProAccount {
  id                Int      @id @default(autoincrement())
  userId            Int      @unique
  status            String   @default("PENDING")
  acceptedTerms     Boolean  @default(true)
  signatureImage    String?
  nationalCode      String?
  fullName          String?
  mobile            String?

  domainName        String?
  cpanelUrl         String?
  cpanelUsername    String?
  cpanelPassword    String?
  wpAdminUrl        String?
  wpUsername        String?
  wpPassword        String?
  hasEnamad         Boolean  @default(false)
  hasGateway        Boolean  @default(false)
  hasTaxProfile     Boolean  @default(false)
  hostExpiresAt     DateTime?
  torobConnected    Boolean  @default(false)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Product {
  id                     Int                     @id @default(autoincrement())
  supplierId             Int
  categoryId             Int
  name                   String
  shortDescription       String?
  longDescription        String?
  technicalSpecs         String?
  supplierBasePrice      Float
  discount               Float                   @default(0)
  sku                    String?
  brand                  String?
  status                 String                  @default("DRAFT")
  marginType             String?
  marginValue            Float?
  finalPrice             Float?
  publishStartDate       DateTime?
  publishEndDate         DateTime?
  minOrderQuantity       Int                     @default(1)
  isPinned               Boolean                 @default(false)
  inventory              Int                     @default(0)
  customerOrderItems     CustomerOrderItem[]     @relation("ProductCustomerOrderItems")
  dailySelections        DailySelection[]
  orderItems             OrderItem[]
  category               Category                @relation(fields: [categoryId], references: [id])
  supplier               User                    @relation(fields: [supplierId], references: [id])
  comments               ProductComment[]
  customizations         ProductCustomization[]
  exploreContent         ProductExploreContent?
  images                 ProductImage[]
  likes                  ProductLike[]
  questions              ProductQuestion[]
  variants               ProductVariant[]
  selectionCartItems     SelectionCartItem[]
  storeProductSelections StoreProductSelection[]
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  products  Product[]
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  url       String
  product   Product @relation(fields: [productId], references: [id])
}

model ProductVariant {
  id                Int         @id @default(autoincrement())
  productId         Int
  attributes        String
  supplierBasePrice Float
  stock             Int
  sku               String?
  imageUrl          String?
  orderItems        OrderItem[]
  product           Product     @relation(fields: [productId], references: [id])
}

model Order {
  id                  Int                  @id @default(autoincrement())
  storeId             Int?
  storeInvoiceId      Int?
  totalAmount         Float
  shippingFee         Float?               @default(0)
  status              String               @default("REQUESTED")
  createdAt           DateTime             @default(now())
  shippingAddressType String?              @default("OTHER_ADDRESS")
  shippingAddress     String?
  shippingMethod      String?              @default("POST")
  postalCode          String?
  trackingCode        String?
  postalLabel         String?
  orderSource         String               @default("store")
  customerName        String?
  customerPhone       String?
  customerAddress     String?
  customerCardNumber  String?
  invoice             StoreInvoice?        @relation(fields: [storeInvoiceId], references: [id])
  store               User?                @relation(fields: [storeId], references: [id])
  items               OrderItem[]
  shippingInvoice     ShippingInvoice?
  statusHistory       OrderStatusHistory[]
}

model OrderItem {
  id            Int             @id @default(autoincrement())
  orderId       Int
  supplierId    Int
  productId     Int
  variantId     Int?
  status        String          @default("PENDING")
  quantity      Int             @default(1)
  notes         String?
  trackingCode  String?
  price         Float           @default(0)
  supplierPrice Float           @default(0)
  variant       ProductVariant? @relation(fields: [variantId], references: [id])
  product       Product         @relation(fields: [productId], references: [id])
  order         Order           @relation(fields: [orderId], references: [id])
}

model StoreInvoice {
  id               Int       @id @default(autoincrement())
  storeManagerId   Int
  totalAmount      Float
  status           String    @default("PENDING")
  paidAt           DateTime?
  trackId          String?
  gatewayReference String?
  paymentMethod    String?   @default("ONLINE")
  receiptUrl       String?
  receiptStatus    String?
  receiptNotes     String?
  createdAt        DateTime  @default(now())
  orders           Order[]
  storeManager     User      @relation(fields: [storeManagerId], references: [id])
}

model StoreSettings {
  id             Int     @id @default(autoincrement())
  storeManagerId Int     @unique
  platformType   String?
  apiKey         String?
  webhookUrl     String?
  storeManager   User    @relation(fields: [storeManagerId], references: [id])
}

model Ticket {
  id         Int             @id @default(autoincrement())
  userId     Int
  subject    String
  department String
  priority   String
  status     String          @default("OPEN")
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  user       User            @relation(fields: [userId], references: [id])
  messages   TicketMessage[]
}

model TicketMessage {
  id            Int      @id @default(autoincrement())
  ticketId      Int
  userId        Int
  message       String
  attachmentUrl String?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])
  ticket        Ticket   @relation(fields: [ticketId], references: [id])
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  ip        String?
  details   String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

model SystemSettings {
  id          Int     @id @default(autoincrement())
  key         String  @unique
  value       String
  description String?
}

model SelectionCart {
  id             Int                 @id @default(autoincrement())
  storeManagerId Int                 @unique
  storeManager   User                @relation(fields: [storeManagerId], references: [id])
  items          SelectionCartItem[]
}

model SelectionCartItem {
  id        Int           @id @default(autoincrement())
  cartId    Int
  productId Int
  quantity  Int
  createdAt DateTime      @default(now())
  product   Product       @relation(fields: [productId], references: [id])
  cart      SelectionCart @relation(fields: [cartId], references: [id])
}

model DailySelection {
  id             Int      @id @default(autoincrement())
  storeManagerId Int
  productId      Int
  date           DateTime @default(now())
  product        Product  @relation(fields: [productId], references: [id])
  storeManager   User     @relation(fields: [storeManagerId], references: [id])
}

model StoreProductSelection {
  id            Int      @id @default(autoincrement())
  storeId       Int
  productId     Int
  status        String   @default("PENDING_SYNC")
  selected_at   DateTime @default(now())
  wc_product_id Int?     @unique
  product       Product  @relation(fields: [productId], references: [id])
  store         User     @relation(fields: [storeId], references: [id])
}

model StoreConnection {
  id                 Int       @id @default(autoincrement())
  storeId            Int       @unique
  platform           String    @default("WOOCOMMERCE")
  storeUrl           String
  consumerKey        String
  consumerSecret     String
  webhookSecret      String?
  status             String    @default("DISCONNECTED")
  lastSync           DateTime?
  lastSuccessfulSync DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  store              User      @relation(fields: [storeId], references: [id])
  syncLogs           SyncLog[]
}

model SyncLog {
  id            Int             @id @default(autoincrement())
  connectionId  Int
  type          String
  direction     String
  status        String
  message       String?
  executionTime Int?
  createdAt     DateTime        @default(now())
  connection    StoreConnection @relation(fields: [connectionId], references: [id])
}

model Wallet {
  id             String          @id @default(cuid())
  balance        Decimal         @default(0.0)
  currency       String          @default("IRR")
  supplierId     Int             @unique
  updatedAt      DateTime        @updatedAt
  ledgerEntries  LedgerEntry[]
  payoutRequests PayoutRequest[]
  supplier       User            @relation(fields: [supplierId], references: [id])
}

model LedgerEntry {
  id              String         @id @default(uuid())
  walletId        String
  amount          Decimal
  type            String
  status          String         @default("PENDING")
  referenceId     String?
  description     String
  createdAt       DateTime       @default(now())
  payoutRequestId String?
  payoutRequest   PayoutRequest? @relation(fields: [payoutRequestId], references: [id])
  wallet          Wallet         @relation(fields: [walletId], references: [id])

  @@index([walletId])
  @@index([createdAt])
  @@index([referenceId])
  @@index([payoutRequestId])
}

model PayoutRequest {
  id                String             @id @default(uuid())
  walletId          String
  supplierId        Int?
  supplierName      String?
  currentBalance    Decimal?
  remainingBalance  Decimal?
  shaba             String
  bankName          String?
  accountHolderName String?
  amount            Decimal
  status            String             @default("PENDING")
  trackId           String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  receiptUrl        String?
  transactionRef    String?
  paymentDate       DateTime?
  paymentNotes      String?
  financiallyLocked Boolean            @default(false)
  adjustments       AdjustmentRecord[]
  ledgerEntries     LedgerEntry[]
  wallet            Wallet             @relation(fields: [walletId], references: [id])

  @@index([walletId])
  @@index([status])
}

model AdjustmentRecord {
  id              String        @id @default(uuid())
  payoutRequestId String
  type            String
  amount          Decimal
  reason          String
  actorId         Int
  createdAt       DateTime      @default(now())
  actor           User          @relation(fields: [actorId], references: [id])
  payoutRequest   PayoutRequest @relation(fields: [payoutRequestId], references: [id])
}

model Payment {
  id               String            @id @default(uuid())
  amount           Decimal
  currency         String            @default("IRR")
  status           String            @default("PENDING")
  idempotencyKey   String            @unique
  gatewayReference String?
  paymentMethod    String?           @default("ONLINE")
  receiptUrl       String?
  receiptStatus    String?
  userId           Int
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  invoice          Invoice?
  user             User              @relation(fields: [userId], references: [id])
  supplierPayables SupplierPayable[]
  transactionLogs  TransactionLog[]

  @@index([idempotencyKey])
  @@index([gatewayReference])
  @@index([status])
}

model SupplierPayable {
  id           String      @id @default(uuid())
  supplierId   Int
  paymentId    String
  settlementId String?
  amount       Decimal
  status       String      @default("PENDING")
  dueDate      DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  settlement   Settlement? @relation(fields: [settlementId], references: [id])
  payment      Payment     @relation(fields: [paymentId], references: [id])
  supplier     User        @relation(fields: [supplierId], references: [id])

  @@index([supplierId])
  @@index([status])
}

model Settlement {
  id             String            @id @default(uuid())
  supplierId     Int
  totalAmount    Decimal
  status         String            @default("PENDING")
  settlementDate DateTime?
  bankReference  String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  supplier       User              @relation(fields: [supplierId], references: [id])
  payables       SupplierPayable[]

  @@index([supplierId])
  @@index([status])
}

model TransactionLog {
  id           String   @id @default(uuid())
  paymentId    String
  action       String
  payload      String?
  responseCode String?
  ipAddress    String?
  createdAt    DateTime @default(now())
  payment      Payment  @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
}

model Invoice {
  id            String   @id @default(uuid())
  invoiceNumber String   @unique
  paymentId     String   @unique
  pdfUrl        String?
  issuedAt      DateTime @default(now())
  payment       Payment  @relation(fields: [paymentId], references: [id])
}

model AuditTrail {
  id        String   @id @default(uuid())
  actorId   Int?
  action    String
  resource  String
  metadata  String?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  type      String?  @default("INFO")
  attachmentUrl String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Announcement {
  id           String    @id @default(uuid())
  title        String
  content      String
  target       String    @default("ALL")
  priority     String    @default("MEDIUM")
  isSticky     Boolean   @default(false)
  isLoginPopup Boolean   @default(false)
  expiryDate   DateTime?
  scheduledFor DateTime?
  attachmentUrl String?
  imageUrl     String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model InfoPage {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  category    String
  summary     String
  content     String
  images      String?
  attachments String?
  videos      String?
  tags        String?
  publishDate DateTime @default(now())
  isPublished Boolean  @default(true)
  isPinned    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  author      String   @default("مدیریت")
}

model PublicMessage {
  id         Int       @id @default(autoincrement())
  content    String
  icon       String    @default("info")
  color      String    @default("indigo")
  expiryDate DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
}

model DashboardMessage {
  id          Int       @id @default(autoincrement())
  title       String
  content     String
  targetRole  String    @default("ALL")
  priority    String    @default("MEDIUM")
  expiryDate  DateTime?
  publishDate DateTime  @default(now())
  attachments String?
  createdAt   DateTime  @default(now())
}

model DynamicMenu {
  role      String   @id
  items     String
  updatedAt DateTime @updatedAt
}

model PenaltyRule {
  id               Int      @id @default(autoincrement())
  title            String
  description      String
  negativePoints   Int
  autoNotification Boolean  @default(true)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  extraData        String?
}

model SupplierPenalty {
  id          Int      @id @default(autoincrement())
  supplierId  Int
  adminId     Int?
  adminName   String?
  reason      String
  points      Int
  description String
  orderNumber String?
  createdAt   DateTime @default(now())
  extraData   String?
  supplier    User     @relation("SupplierPenalties", fields: [supplierId], references: [id])
}

model PenaltyConfig {
  id                           Int      @id @default(autoincrement())
  underReviewThreshold         Int      @default(20)
  temporarySuspensionThreshold Int      @default(40)
  blockedThreshold             Int      @default(60)
  autoSuspensionEnabled        Boolean  @default(true)
  updatedAt                    DateTime @updatedAt
}

model Banner {
  id              Int      @id @default(autoincrement())
  title           String
  description     String
  imageUrl        String?
  isActive        Boolean  @default(true)
  displayLocation String   @default("SHOP")
  createdAt       DateTime @default(now())
}

model WebhookRetry {
  id          String   @id @default(uuid())
  topic       String?
  payload     String
  storeId     Int?
  attempts    Int      @default(0)
  maxAttempts Int      @default(5)
  nextRetryAt DateTime @default(now())
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ReferrerReferral {
  id         Int      @id @default(autoincrement())
  referrerId Int
  supplierId Int      @unique
  createdAt  DateTime @default(now())
  supplier   User     @relation("SupplierRel", fields: [supplierId], references: [id])
  referrer   User     @relation("ReferrerRel", fields: [referrerId], references: [id])
}

model CustomerOrder {
  id               String              @id @default(uuid())
  orderNumber      String              @unique
  storeId          Int
  recipientName    String
  recipientPhone   String
  recipientAddress String
  totalAmount      Decimal
  status           String              @default("PENDING")
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  store            User                @relation("StoreCustomerOrders", fields: [storeId], references: [id])
  items            CustomerOrderItem[]
}

model CustomerOrderItem {
  id        String        @id @default(uuid())
  orderId   String
  productId Int
  quantity  Int
  price     Decimal
  product   Product       @relation("ProductCustomerOrderItems", fields: [productId], references: [id])
  order     CustomerOrder @relation(fields: [orderId], references: [id])
}

model OrderStatusHistory {
  id         Int      @id @default(autoincrement())
  orderId    Int
  fromStatus String?
  toStatus   String
  actorRole  String
  actorName  String?
  note       String?
  createdAt  DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model ProductLike {
  id        Int      @id @default(autoincrement())
  productId Int
  deviceId  String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, deviceId])
}

model ProductComment {
  id         Int      @id @default(autoincrement())
  productId  Int
  authorName String
  text       String
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductQuestion {
  id             Int       @id @default(autoincrement())
  productId      Int
  storeManagerId Int?
  askerName      String?
  questionText   String
  answerText     String?
  isAnswered     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  answeredAt     DateTime?
  storeManager   User?     @relation(fields: [storeManagerId], references: [id])
  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductCustomization {
  id                Int      @id @default(autoincrement())
  storeManagerId    Int
  productId         Int
  customTitle       String?
  customDescription String?
  customVideoUrl    String?
  customImageUrl    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  storeManager      User     @relation(fields: [storeManagerId], references: [id], onDelete: Cascade)
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storeManagerId, productId])
}

model ProductExploreContent {
  id                Int      @id @default(autoincrement())
  productId         Int      @unique
  customTitle       String?
  customDescription String?
  customImageUrl    String?
  customVideoUrl    String?
  isPublished       Boolean  @default(false)
  updatedAt         DateTime @updatedAt
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ShippingInvoice {
  id             Int      @id @default(autoincrement())
  orderId        Int      @unique
  shippingCost   Float
  shippingMethod String
  description    String?
  status         String   @default("PENDING") // PENDING, PAID
  payLink        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  order          Order    @relation(fields: [orderId], references: [id])
}
